# Working artifacts — local, not distributed
# docs/terylon/ is the terylon working tree (intake, specs, plans, ledgers);
# docs/superpowers/ is the superpowers scratch area when those skills run directly.
docs/terylon/
docs/superpowers/

# Isolated worktrees — created by the create-workspace skill and by native worktree tooling
.claude/worktrees/

# Local settings override — used to point the marketplace at a feature branch
# during development. Never commit it; settings.json is the shared one.
.claude/settings.local.json

# OS / editor
Thumbs.db
.DS_Store
.vs/
.vscode/
*.user

# The engine lays its own declarations beside a mod it loads from a watched folder; written again
# each load, never committed.
plugins/*/.claude-plugin/types/
plugins/*/tsconfig.json

# Test coverage, written by node --test --experimental-test-coverage; Codecov holds the report
lcov.info
coverage/
# lychee's result cache, from a local run of the link check
.lycheecache
