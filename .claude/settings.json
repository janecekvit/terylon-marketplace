{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(type:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(comm:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(awk:*)",
      "Bash(sed -n*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(where:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(xargs grep *)",
      "Bash(xxd:*)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(date:*)",
      "Bash(env)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(node -e *)",
      "Bash(Get-ChildItem:*)",
      "Bash(Get-Content:*)",
      "Bash(Get-Item:*)",
      "Bash(Get-ItemProperty:*)",
      "Bash(Get-Location:*)",
      "Bash(Get-Date:*)",
      "Bash(Get-Process:*)",
      "Bash(Get-Command:*)",
      "Bash(Get-Member:*)",
      "Bash(Get-Help:*)",
      "Bash(Get-Module:*)",
      "Bash(Get-Variable:*)",
      "Bash(Test-Path:*)",
      "Bash(Resolve-Path:*)",
      "Bash(Split-Path:*)",
      "Bash(Join-Path:*)",
      "Bash(Select-String:*)",
      "Bash(Select-Object:*)",
      "Bash(Where-Object:*)",
      "Bash(ForEach-Object:*)",
      "Bash(Measure-Object:*)",
      "Bash(Sort-Object:*)",
      "Bash(Group-Object:*)",
      "Bash(Compare-Object:*)",
      "Bash(Out-String:*)",
      "Bash(Out-Host:*)",
      "Bash(Format-Table:*)",
      "Bash(Format-List:*)",
      "Bash(Format-Wide:*)",
      "Bash(ConvertTo-Json:*)",
      "Bash(ConvertFrom-Json:*)",
      "Bash(ConvertTo-Csv:*)",
      "Bash(ConvertFrom-Csv:*)",
      "Bash(Write-Host:*)",
      "Bash(Write-Output:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git blame*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git shortlog*)",
      "Bash(git cat-file*)",
      "Bash(git grep*)",
      "Bash(git tag*)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(git for-each-ref*)",
      "Bash(git reflog*)",
      "Bash(git stash list*)",
      "Bash(git symbolic-ref*)",
      "Bash(git check-ignore*)",
      "Bash(git add *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git switch -c *)",
      "Bash(git stash*)",
      "Bash(git restore --staged *)",
      "mcp__plugin_terylon-ado_ado__*"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push * main)",
      "Bash(git push origin main:*)",
      "Bash(git push * main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push origin *:main)",
      "Bash(git push * *:main)",
      "Bash(git push origin refs/heads/main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git merge origin/main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
