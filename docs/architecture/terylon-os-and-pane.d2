# terylon-os and its mod terylon-pane: how a session reaches Terylon's Agentic OS, and why the
# gates stay in the console.
# Source of truth for terylon-os-and-pane.svg beside it: edit this file, then run
# Scripts/render-diagrams.sh and commit both.
# Why every surface goes through the one /mcp: one-source-of-truth-reached-from-two-places.md.
vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

# One colour per kind: the plugin (indigo), the mod (violet), Agentic OS (blue), gates (red),
# the person and the phone (grey).
classes: {
  plugin: {
    style: {
      fill: "#E0E7FF"
      stroke: "#4F46E5"
      font-color: "#312E81"
    }
  }
  mod: {
    style: {
      fill: "#F3E8FF"
      stroke: "#9333EA"
      font-color: "#581C87"
    }
  }
  system: {
    style: {
      fill: "#DBEAFE"
      stroke: "#2563EB"
      font-color: "#1E3A8A"
    }
  }
  gate: {
    style: {
      fill: "#FEE2E2"
      stroke: "#DC2626"
      font-color: "#7F1D1D"
    }
  }
  external: {
    style: {
      fill: "#F3F4F6"
      stroke: "#6B7280"
      font-color: "#374151"
    }
  }
}

session: "Claude Desktop or Claude Code: a local session on the PC" {
  style: {
    fill: "#F8FAFC"
    stroke: "#475569"
  }

  os: "terylon-os plugin: no dependencies" {
    style: {
      fill: "#EEF2FF"
      stroke: "#6366F1"
    }

    # A single-quoted string: D2 substitutes nothing inside it, so the variable is drawn as written.
    server: 'server terylon at ${TERYLON_URL}/mcp' {class: plugin}
    skills: "one skill per prompt it serves\nbriefing, hand-over, merge-gate,\nadd-goal, review-plan, show-story" {class: plugin}
  }

  pane: "terylon-pane mod: shows, asks, answers, posts; never approves" {
    style: {
      fill: "#FAF5FF"
      stroke: "#A855F7"
    }

    allow_list: "PANE_TOOLS: reads + five writes that decide nothing\nnever a gate tool" {class: mod}
    band: "the band above the prompt\nwhat calls for the owner" {class: mod}
    status_line: "the status line\nthe health of Agentic OS, its worst problem" {class: mod}
    tabs: "one pane, five tabs\nQueue, Goals, Bell, Memory, Status\nopened only by the band or a command" {class: mod}
  }
}

phone: "The phone, through Remote Control\nterylon-os on an always-on box; no mod" {class: external}

terylon: "Terylon's Agentic OS: the only source of truth" {
  style: {
    fill: "#EFF6FF"
    stroke: "#3B82F6"
  }

  mcp: "/mcp\nthe caller's tailnet identity; no header, no token" {class: system}
  leader: "leader, goals, plans, stories,\nbell, memory" {class: system}
  console: "the console: every gate\nplan approve or rethink, merge, return, unblock,\nabandon, stop, accept, leader pause or resume" {class: gate}
}

person: "the owner" {
  shape: person
  class: external
}

session.pane -> session.os: "dependencies: terylon-os" {
  style.stroke-dash: 3
}
session.os.server -> terylon.mcp: "over the tailnet"
session.pane.allow_list -> session.os.server: "every 30 s: briefing, work_in_flight,\nstories_list, events_since"
session.pane.allow_list -> session.pane.band
session.pane.allow_list -> session.pane.status_line
session.pane.allow_list -> session.pane.tabs
session.pane.tabs -> terylon.console: "a gate is a link, never a button" {
  style.stroke-dash: 3
}
phone -> terylon.mcp: "the same /mcp"
terylon.mcp -> terylon.leader
person -> terylon.console: "confirms every gate"
