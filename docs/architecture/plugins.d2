# The marketplace's plugins and the dependencies their manifests declare.
# Source of truth for plugins.svg beside it: edit this file, then run
# Scripts/render-diagrams.sh and commit both.
# Every edge between two plugins is one entry of a plugin.json#dependencies array, drawn from the
# plugin that declares it to the plugin it names. A dashed one is declared although the chain
# already reaches it. The manifests are the source of truth; when they change, redraw this.
vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: up

# One colour per kind: roots (indigo), the git layer (blue), the port (amber), adapters (green),
# role plugins (slate), Terylon's own plugins (violet), notes (grey).
classes: {
  root: {
    style: {
      fill: "#E0E7FF"
      stroke: "#4F46E5"
      font-color: "#312E81"
    }
  }
  layer: {
    style: {
      fill: "#DBEAFE"
      stroke: "#2563EB"
      font-color: "#1E3A8A"
    }
  }
  port: {
    style: {
      fill: "#FEF3C7"
      stroke: "#D97706"
      font-color: "#78350F"
    }
  }
  adapter: {
    style: {
      fill: "#D1FAE5"
      stroke: "#059669"
      font-color: "#064E3B"
    }
  }
  role: {
    style: {
      fill: "#F1F5F9"
      stroke: "#475569"
      font-color: "#1E293B"
    }
  }
  terylon: {
    style: {
      fill: "#F3E8FF"
      stroke: "#9333EA"
      font-color: "#581C87"
    }
  }
  note: {
    style: {
      fill: "#F9FAFB"
      stroke: "#9CA3AF"
      font-color: "#374151"
    }
  }
}

core: "terylon-core\nthe root: shared conventions, measurement\nno dependencies" {class: root}
git: "terylon-git\n+ git; no forge, no MCP server" {class: layer}
forge: "terylon-forge\nthe forge port: the pull request workflow\nno adapter declared" {class: port}

adapters: "Adapters: one body of forge-ops each" {
  style: {
    fill: "#ECFDF5"
    stroke: "#10B981"
  }

  ado: "terylon-ado\nAzure DevOps, Microsoft's remote MCP server" {class: adapter}
  github: "terylon-github\nGitHub, over the gh CLI; no server" {class: adapter}
}

roles: "Role plugins" {
  style: {
    fill: "#F8FAFC"
    stroke: "#64748B"
  }

  product: "terylon-product\nuser stories, Feature specs" {class: role}
  dev: "terylon-dev\nthe build pipeline" {class: role}
  test: "terylon-test\na test plan and acceptance criteria" {class: role}
}

# Terylon's own plugins: the owner's product, not a role in the development workflow.
outside: "Outside the chain: Terylon itself" {
  style: {
    fill: "#FAF5FF"
    stroke: "#A855F7"
    stroke-dash: 3
  }

  os: "terylon-os\nTerylon's /mcp server + one skill per prompt\nno dependencies" {class: root}
  pane: "terylon-pane\na mod: the band, the status line, the pane" {class: terylon}
}

consumer: "A consumer repository enables two keys:\na role plugin + an adapter.\nEverything else arrives as a dependency." {
  shape: page
  class: note
}

git -> core
forge -> git
adapters.ado -> forge
adapters.github -> forge
roles.product -> forge
roles.dev -> forge
roles.test -> forge
roles.dev -> git: "also direct: leader dispatches code-reviewer" {
  style.stroke-dash: 3
}
roles.dev -> core: "also direct: measure-token-spend" {
  style.stroke-dash: 3
}
roles.test -> core: "also direct: measure-token-spend" {
  style.stroke-dash: 3
}
outside.pane -> outside.os

consumer -> roles: "enables one" {
  style.stroke: "#9CA3AF"
  style.stroke-dash: 5
}
consumer -> adapters: "enables one" {
  style.stroke: "#9CA3AF"
  style.stroke-dash: 5
}
